# Milestone 2 benchmark remote configuration.
#
# Copy to config/remote/paths.env on the remote CPU/GPU machine and edit only
# machine-specific storage roots if they differ. This file intentionally points
# at the benchmark-specific FASTA manifest and AlphaPulldown input directory;
# it must not use the 62-target universe manifest.

REMOTE_PROJECT_ROOT="/workspace/alphapulldown"
REMOTE_EXECUTION_STAGE="cpu"
CONTAINER_RUNTIME="docker-native"

PYTHON_BIN="python3"

FEATURE_MODE="mmseqs2"
DATABASES_DIR=""
BACKEND_WEIGHTS_DIR=""
NATIVE_DATA_PIPELINE="alphafold2"
NATIVE_FOLD_BACKEND="alphafold2"
NATIVE_ENABLE_ALPHAJUDGE="false"
MAX_TEMPLATE_DATE="2050-01-01"

FASTA_DIR="${REMOTE_PROJECT_ROOT}/data/processed/fasta"
FASTA_MANIFEST="${REMOTE_PROJECT_ROOT}/data/processed/benchmarks/fasta/fasta_manifest.tsv"
ALPHAPULLDOWN_INPUT_DIR="${REMOTE_PROJECT_ROOT}/data/processed/benchmarks/alphapulldown_inputs"

OUTPUT_DIR="${REMOTE_PROJECT_ROOT}/results/milestone2_benchmark/alphapulldown"
FEATURE_DIR="${REMOTE_PROJECT_ROOT}/results/milestone2_benchmark/features"
LOG_DIR="${REMOTE_PROJECT_ROOT}/results/milestone2_benchmark/logs"
TMP_DIR="${REMOTE_PROJECT_ROOT}/results/milestone2_benchmark/tmp"
PROVENANCE_DIR="${REMOTE_PROJECT_ROOT}/results/provenance/milestone2_benchmark"

FEATURE_FILE_PATTERN="{record_id}.pkl.xz"

NATIVE_IMAGE_LOCK="${REMOTE_PROJECT_ROOT}/deployment/runpod/image-lock.json"
ALPHAPULLDOWN_BASE_IMAGE_DIGEST="sha256:434704a18e24d59de7cbfd6f7cdc310d5dce03ded6cf91c4927b6e2c9e87110c"
# Replace after the derived image is built and its registry digest is recorded.
ALPHAPULLDOWN_DERIVED_IMAGE_DIGEST="UNBUILT"
ALPHAPULLDOWN_EXPECTED_VERSION="2.5.0"
# Fill only after the direct-image proof of concept confirms /AlphaPulldown.
ALPHAPULLDOWN_EXPECTED_REVISION=""

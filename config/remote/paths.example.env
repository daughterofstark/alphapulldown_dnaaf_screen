# Copy to config/remote/paths.env on the Linux host and edit values.
# Do not commit config/remote/paths.env.

REMOTE_PROJECT_ROOT="${HOME}/alphapulldown"
AP_SNAKEMAKE_VERSION="2.5.0"
AP_WORKFLOW_DIR="${HOME}/workflows/AlphaPulldownSnakemake"
CONDA_ENV_NAME="snake"

PYTHON_BIN="python3"

FEATURE_MODE="localdb"
DATABASES_DIR="${HOME}/alphafold_databases"
BACKEND_WEIGHTS_DIR="${HOME}/alphafold_weights"

FASTA_DIR="${REMOTE_PROJECT_ROOT}/data/processed/fasta"
FASTA_MANIFEST="${REMOTE_PROJECT_ROOT}/data/processed/fasta/fasta_manifest.tsv"
ALPHAPULLDOWN_INPUT_DIR="${REMOTE_PROJECT_ROOT}/data/processed/alphapulldown"

OUTPUT_DIR="${REMOTE_PROJECT_ROOT}/results/alphapulldown"
FEATURE_DIR="${OUTPUT_DIR}/features"
LOG_DIR="${REMOTE_PROJECT_ROOT}/results/logs"
TMP_DIR="${REMOTE_PROJECT_ROOT}/results/tmp"
PROVENANCE_DIR="${REMOTE_PROJECT_ROOT}/results/provenance"

FEATURE_CONFIG="${REMOTE_PROJECT_ROOT}/config/remote/feature_generation.example.yaml"
PREDICTION_CONFIG="${REMOTE_PROJECT_ROOT}/config/remote/prediction.example.yaml"

FEATURE_FILE_PATTERN="{record_id}_af3_input.json"
SNAKEMAKE_CORES="8"
SNAKEMAKE_JOBS="200"
SNAKEMAKE_PROFILE="${AP_WORKFLOW_DIR}/config/profiles/desktop"
SLURM_PROFILE="${AP_WORKFLOW_DIR}/config/profiles/slurm"

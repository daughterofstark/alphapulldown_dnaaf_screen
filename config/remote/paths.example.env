# Copy to config/remote/paths.env on the Linux host and edit values.
# Do not commit config/remote/paths.env.

# Execution stage controls host validation:
# - cpu: container preparation and/or MMseqs2 feature generation; no NVIDIA GPU required.
# - gpu: prediction/inference; NVIDIA GPU and nvidia-smi required.
REMOTE_EXECUTION_STAGE="cpu"

REMOTE_PROJECT_ROOT="/workspace/alphapulldown"
AP_SNAKEMAKE_VERSION="2.5.0"
AP_WORKFLOW_DIR="/workspace/workflows/AlphaPulldownSnakemake"
CONDA_ENV_NAME="snake"
# Optional local copy of the pinned upstream environment YAML. Prefer this on
# systems where `conda env create -f <URL>` has unreliable pip handling.
AP_ENV_YAML=""
SNAKEDEPLOY_BIN="snakedeploy"

PYTHON_BIN="python3"

FEATURE_MODE="localdb"
DATABASES_DIR="${HOME}/alphafold_databases"
BACKEND_WEIGHTS_DIR="${HOME}/alphafold_weights"

FASTA_DIR="${REMOTE_PROJECT_ROOT}/data/processed/fasta"
FASTA_MANIFEST="${REMOTE_PROJECT_ROOT}/data/processed/fasta/fasta_manifest.tsv"
ALPHAPULLDOWN_INPUT_DIR="${REMOTE_PROJECT_ROOT}/data/processed/alphapulldown"

OUTPUT_DIR="${REMOTE_PROJECT_ROOT}/results/alphapulldown"
FEATURE_DIR="${OUTPUT_DIR}/features"
LOG_DIR="${REMOTE_PROJECT_ROOT}/results/logs"
TMP_DIR="${REMOTE_PROJECT_ROOT}/results/tmp"
PROVENANCE_DIR="${REMOTE_PROJECT_ROOT}/results/provenance"

FEATURE_CONFIG="${REMOTE_PROJECT_ROOT}/config/remote/feature_generation.example.yaml"
PREDICTION_CONFIG="${REMOTE_PROJECT_ROOT}/config/remote/prediction.example.yaml"

FEATURE_FILE_PATTERN="{record_id}_af3_input.json"
SNAKEMAKE_CORES="8"
SNAKEMAKE_JOBS="1"
# Snakedeploy 2.5.0 may deploy a module wrapper without upstream profiles.
# Leave profiles empty for single-node/RunPod execution; the wrapper will use
# `snakemake --cores`.
SNAKEMAKE_PROFILE=""
SLURM_PROFILE=""

# Apptainer container preparation. Keep completed SIF images on persistent
# storage, but build them on explicitly selected local disk after checking free
# space and filesystem type.
APPTAINER_IMAGE_DIR="${REMOTE_PROJECT_ROOT}/results/containers"
APPTAINER_PERSISTENT_CACHE_DIR="${REMOTE_PROJECT_ROOT}/results/apptainer_cache"
APPTAINER_PREFIX="${APPTAINER_IMAGE_DIR}/snakemake_apptainer"
APPTAINER_LOCAL_BUILD_DIR=""
APPTAINER_MIN_LOCAL_FREE_GB="28"
APPTAINER_PREDICTION_IMAGE="docker://kosinskilab/alphafold2:2.5.0"
# Set this to the completed, verified SIF after Phase A container preparation.
APPTAINER_PREDICTION_SIF=""
